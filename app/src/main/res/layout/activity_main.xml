<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- App Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UDC SMS Assistant"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvServiceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UDC SMS Assistant: সার্বক্ষণিক সক্রিয় (Active)"
                    android:textColor="#10B981"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEngineStateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#064E3B"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🟢 LISTENING"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mobile Device ID & Live Database Pairing Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDeviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#0F1F38"
            app:cardCornerRadius="12dp"
            app:strokeColor="#2563EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDeviceIdBadge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📱 মোবাইল আইডি: APP-সংযোগ হচ্ছে..."
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDeviceBatteryBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1E293B"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="🔋 --%"
                        android:textColor="#A7F3D0"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPairingStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1E293B"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="🔗 এক্সটেনশন পেয়ারিংয়ের অপেক্ষায়"
                        android:textColor="#93C5FD"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDeviceHeartbeatStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="ডাটাবেজ: অনলাইন"
                        android:textColor="#64748B"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PROMINENT PERMISSION MANAGER & RESTRICTED SETTINGS ALERT CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPermissionAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#450A0A"
            app:cardCornerRadius="12dp"
            app:strokeColor="#EF4444"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPermissionIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚨"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvPermissionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="SMS পারমিশন বন্ধ আছে! মেসেজ ডিটেক্ট হচ্ছে না"
                        android:textColor="#FCA5A5"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPermissionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#991B1B"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="অ্যাকশন প্রয়োজন"
                        android:textColor="#FEE2E2"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPermissionDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="অ্যান্ড্রয়েড ১৩/১৪ বা শাওমি ফোনে অ্যাপ সরাসরি ইনস্টল করলে SMS পারমিশন ব্লক থাকে। নিচের বাটনে চাপ দিয়ে সেটিংস থেকে 'Allow restricted settings' বা SMS পারমিশন এলাও করুন।"
                    android:textColor="#FECACA"
                    android:textSize="11sp" />

                <!-- Action Buttons: Open App Settings & Guide -->
                <LinearLayout
                    android:id="@+id/llPermissionButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnOpenAppSettings"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:backgroundTint="#DC2626"
                        android:text="⚙️ সেটিংস খুলুন"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnShowPermissionGuide"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="📖 সমাধান গাইড"
                        android:textColor="#FCA5A5"
                        android:textSize="11sp"
                        app:strokeColor="#F87171" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnRequestPermissionsDirect"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="4dp"
                    android:text="🔄 পুনরায় পারমিশন ডায়ালগ চালু করুন"
                    android:textColor="#F87171"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TOP CARD: Dedicated Live SMS Capture & Detection Interface -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCapturedSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:cardBackgroundColor="#0B132B"
            app:cardCornerRadius="14dp"
            app:strokeColor="#10B981"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header row with badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📥"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="সর্বশেষ প্রাপ্ত SMS ও ওটিপি ডিটেক্টর"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSmsStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1E293B"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="⏳ অপেক্ষমাণ"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Detection outcome banner -->
                <TextView
                    android:id="@+id/tvSmsDetectionSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#1E293B"
                    android:padding="8dp"
                    android:text="আইভ্যাক থেকে কোনো মেসেজ আসলেই সেটি ডিটেক্ট করতে পেরেছে কিনা এখানে তৎক্ষণাৎ দেখা যাবে"
                    android:textColor="#38BDF8"
                    android:textSize="11sp" />

                <!-- Meta info (Sender, SIM slot, Time) -->
                <TextView
                    android:id="@+id/tvSmsMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="📶 সিম: -- • প্রেরক: -- • সময়: --"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <!-- Extracted OTP Box -->
                <LinearLayout
                    android:id="@+id/llSmsOtpBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#064E3B"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔑 ডিটেক্টেড ওটিপি কোড (Extracted OTP):"
                            android:textColor="#A7F3D0"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvSmsOtpCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:text="------"
                            android:textColor="#34D399"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnCopyOtp"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="#059669"
                        android:text="📋 কপি"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Full Captured Message Display (Full SMS Body) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="📜 পুরো মেসেজ যা ফোনে রিসিভ ও ক্যাপচার হয়েছে (Full Raw SMS Body):"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSmsFullBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#020617"
                    android:padding="12dp"
                    android:text="এখনও কোনো এসএমএস আসেনি। নতুন এসএমএস এলে পুরো বার্তাটি এখানে তাৎক্ষণিক দেখা যাবে..."
                    android:textColor="#F1F5F9"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <!-- Server Forwarding Status -->
                <TextView
                    android:id="@+id/tvSmsForwardStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#1E293B"
                    android:padding="8dp"
                    android:text="সার্ভার স্ট্যাটাস: রেডি (অপেক্ষমাণ)"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp" />

                <!-- Action Buttons: Check Inbox SMS + Simulate Test SMS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCheckInbox"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:backgroundTint="#1E293B"
                        android:text="🔄 ইনবক্স চেক করুন"
                        android:textColor="#38BDF8"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnSimulateTestSms"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#1E293B"
                        android:text="🧪 টেস্ট মেসেজ দিন"
                        android:textColor="#34D399"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SMS History List Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSmsHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📜 বিগত ডিটেক্টেড মেসেজ হিস্ট্রি"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnClearHistory"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="মুছুন"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llSmsHistoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNoHistoryPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#0F172A"
                        android:padding="10dp"
                        android:text="এখনও কোনো মেসেজ হিস্ট্রি নেই..."
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SIM Configuration Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvSim1Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📶 সিম ১ (স্লট ১)"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="পিসি-১ এর এক্সটেনশনে ব্যবহৃত মোবাইল নম্বর:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etSim1Phone"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="#0F172A"
                    android:hint="017XXXXXXXX"
                    android:inputType="phone"
                    android:paddingHorizontal="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSim2Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="📶 সিম ২ (স্লট ২)"
                    android:textColor="#F59E0B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="পিসি-২ এর এক্সটেনশনে ব্যবহৃত মোবাইল নম্বর:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etSim2Phone"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="#0F172A"
                    android:hint="019XXXXXXXX"
                    android:inputType="phone"
                    android:paddingHorizontal="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvServerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="🌐 ক্লাউড সার্ভার URL (API Link):"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="অ্যাপ ও এক্সটেনশন সংযোগকারী সার্ভার লিঙ্ক:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="#0F172A"
                    android:hint="https://ais-dev-...asia-southeast1.run.app"
                    android:inputType="textUri"
                    android:paddingHorizontal="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTestServerConnection"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="#1E293B"
                        android:text="🔌 সার্ভার টেস্ট (Ping)"
                        android:textColor="#38BDF8"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnSendTestOtpDirect"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#064E3B"
                        android:text="⚡ টেস্ট OTP পুশ"
                        android:textColor="#34D399"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#10B981"
                    android:text="💾 নম্বর ও সার্ভার লিঙ্ক সংরক্ষণ করুন (Save)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Battery Optimization Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#172554"
            app:cardCornerRadius="12dp"
            app:strokeColor="#1E40AF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔋 ব্যাকগ্রাউন্ড ওটিপি গতি (Battery Saver Off)"
                    android:textColor="#93C5FD"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="স্ক্রিন অফ থাকলেও তৎক্ষণাৎ ওটিপি পেতে ব্যাটারি অপ্টিমাইজেশন বন্ধ রাখুন।"
                    android:textColor="#BFDBFE"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnRequestBattery"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:text="⚡ Unrestricted Battery পারমিশন দিন"
                    android:textColor="#93C5FD"
                    android:textSize="11sp"
                    app:strokeColor="#60A5FA" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Live Activity Monitor Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#0B132B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#0EA5E9"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 UDC SMS Assistant লাইভ মনিটর"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLiveIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1E293B"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="🟢 LIVE"
                        android:textColor="#34D399"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llActivityContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNoActivityPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#0F172A"
                        android:padding="10dp"
                        android:text="ব্রাউজারে এক্সটেনশন চালু হলে লাইভ আপডেট এখানে দেখা যাবে..."
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
